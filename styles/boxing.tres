&"kick": &"jump_punch",
&"lead": &"jump_punch",
&"light": &"jump_punch",
&"rising": &"jump_punch",
&"front": &"jump_punch"
}
chains = {
&"body_hook": [&"lead_hook", &"uppercut", &"cross"],
&"cross": [&"lead_hook", &"body_hook", &"uppercut"],
&"jab": [&"jab", &"cross", &"lead_hook", &"rear_hook", &"body_hook", &"uppercut", &"overhand"],
&"lead_hook": [&"cross", &"rear_hook", &"body_hook", &"uppercut"],
